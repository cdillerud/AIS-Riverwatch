# River Watch backend configuration. Copy to backend/.env (local) or set in
# your deployment environment. Never commit real values.

# --- Required ----------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=riverwatch

# --- Web security ------------------------------------------------------------
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when nginx serves the frontend and API on the same origin.
# "*" disables credentialed CORS (sign-in won't work cross-origin).
CORS_ORIGINS=http://localhost:3000
# Session cookie: lax (default) | strict | none. Use "none" only for a frontend
# on a different site, together with explicit CORS_ORIGINS.
COOKIE_SAMESITE=lax
# false only for plain-HTTP local development / boat LAN kiosks.
COOKIE_SECURE=true

# --- Accounts ------------------------------------------------------------------
# Google sign-in: OAuth client ID of a "Web application" client in Google Cloud
# Console (APIs & Services > Credentials), with this site's origin listed under
# "Authorized JavaScript origins". Empty = Google button hidden; email/password only.
GOOGLE_CLIENT_ID=
# This account always gets super-admin rights when it signs in.
SUPER_ADMIN_EMAIL=

# --- AIS ingest ----------------------------------------------------------------
# Shared secret that push relays send as X-Ingest-Token to /api/ais/ingest.
# Empty = open ingest (anyone can post positions) - set this in production.
AIS_INGEST_TOKEN=
# Hosts the server may dial for a TCP AIS feed without address checks.
AIS_TARGET_ALLOWLIST=ais-relay
# true: allow private/LAN feed addresses (self-hosted on the boat network).
# false: hosted server - only public addresses (prevents probing internal networks).
AIS_ALLOW_PRIVATE_TARGETS=true

# --- AIS push relay (ais_push_relay/) ----------------------------------------------
AIS_RELAY_URL=http://ais-relay:8088
AIS_RELAY_TOKEN=
AIS_RELAY_TIMEOUT=8.0

# --- Vessel lifecycle ----------------------------------------------------------
# Vessels not heard from for this long are removed from the live picture.
RIVERWATCH_VESSEL_STALE_SECONDS=600
RIVERWATCH_VESSEL_STALE_SWEEP_SECONDS=60
# Demo vessels: auto (hide once a live AIS feed is seen) | on | off
RIVERWATCH_DEMO_VESSELS_MODE=auto

# --- Second AIS source: aisstream.io -------------------------------------------
# Free API key from https://aisstream.io. Empty = disabled. Data from both
# sources is merged; GET /api/admin/feeds/coverage compares what each one sees.
AISSTREAM_API_KEY=
# Optional "lat1,lon1,lat2,lon2"; default covers the Upper Mississippi.
AISSTREAM_BBOX=
