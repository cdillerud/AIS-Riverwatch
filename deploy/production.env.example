# River Watch production settings - copy to .env next to docker-compose.prod.yml
# and fill in. Never commit the real .env.

# --- Required -----------------------------------------------------------------
# Public hostname; its DNS A record must point at this server before first start.
RIVERWATCH_DOMAIN=riverwatch.example.com
# This account gets super-admin rights when it signs in.
SUPER_ADMIN_EMAIL=you@example.com

# --- Recommended -------------------------------------------------------------
# Let's Encrypt expiry notices (optional but useful).
ACME_EMAIL=you@example.com
# Google sign-in: OAuth client ID ("Web application") with
# https://<RIVERWATCH_DOMAIN> under Authorized JavaScript origins. Empty = email/password only.
GOOGLE_CLIENT_ID=
# Shared secret AIS push relays send as X-Ingest-Token (generate: openssl rand -hex 24).
# Without it anyone can post vessel positions to /api/ais/ingest.
AIS_INGEST_TOKEN=

# --- Optional ----------------------------------------------------------------
# Second live AIS source. Trial on 2026-11-10 found ~no Upper Mississippi coverage.
AISSTREAM_API_KEY=
# Hosted server: never dial private/LAN addresses on users' behalf.
AIS_ALLOW_PRIVATE_TARGETS=false
# Demo boats: off unless an admin enables them; "on" only for a sales/demo instance.
RIVERWATCH_DEMO_VESSELS_MODE=auto

# --- Email (Hostinger Email on riverwatchais.com) ------------------------------
# Daily reports and feed-outage alerts. Create the mailbox in hPanel > Emails,
# then put its password here on the server only - never in git.
APP_PUBLIC_URL=https://riverwatchais.com
REPORT_SMTP_HOST=smtp.hostinger.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USER=alerts@riverwatchais.com
REPORT_SMTP_PASSWORD=
REPORT_EMAIL_FROM=River Watch <alerts@riverwatchais.com>

# Web Push: tow / lock / leave-now alerts while River Watch is closed.
# Generate once: docker compose -f docker-compose.prod.yml exec backend python scripts/make_vapid_keys.py
# Empty = off (alerts then arrive only while the app is open). Keep the private key secret;
# changing the keys later means every boater has to turn alerts off and on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:you@example.com or https://<RIVERWATCH_DOMAIN>
VAPID_SUBJECT=
